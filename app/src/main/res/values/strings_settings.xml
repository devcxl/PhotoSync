    <!-- Tethering and gallery -->
    <string name="settings_auto_follow">新照片自动跳转</string>
    <string name="settings_auto_follow_hint">相机新照片入库后自动切到最新一张；正在放大查看时不会打扰。</string>
    <string name="settings_delete_on_camera">删除时同步删除相机照片</string>
    <string name="settings_delete_on_camera_hint">与删除确认框中的勾选保持同步；相机不支持时会自动回退为仅删本机副本。</string>
    <string name="settings_keep_screen_on">浏览时保持屏幕常亮</string>
    <string name="settings_keep_screen_on_hint">仅影响主界面与编辑器的亮屏策略，不改变导出结果。</string>
    <string name="settings_live_preset_enabled">联机预设自动套用</string>
    <string name="settings_live_preset_enabled_hint">关闭后仍记住已选预设，但新照片不再自动套用。</string>

    <!-- Editor -->
    <string name="settings_preview_resolution">预览分辨率</string>
    <string name="settings_preview_resolution_hint">下次打开编辑器生效；天空预览按同比例同步。</string>
    <string name="settings_export_quality">导出 JPEG 质量</string>
    <string name="settings_export_quality_hint">下次导出生效；范围 85–100。</string>
    <string name="settings_undo_depth">撤销深度</string>
    <string name="settings_undo_depth_hint">下次打开编辑器生效；范围 20–200 步。</string>
    <string name="settings_lut_library">LUT 库管理</string>
    <string name="settings_lut_library_hint">点按查看已导入条目、占用与删除；支持从 SAF 导入 .cube 文件。</string>

    <!-- AI tools -->
    <string name="settings_ai_models">AI 模型管理</string>
    <string name="settings_ai_models_hint">按需下载、本地导入与校验状态。</string>
    <string name="settings_sky_assets">天空素材管理</string>
    <string name="settings_sky_assets_hint">点按查看已导入天空、占用与删除；支持从 SAF 导入图片。</string>
    <string name="settings_tier_override">设备档位覆盖</string>
    <string name="settings_tier_override_hint">只影响 AI 运行策略与内存预算，不改变像素结果；下一次 AI 推理生效。</string>
    <string name="settings_intra_threads">推理线程数</string>
    <string name="settings_intra_threads_hint">下次加载模型生效；范围 1–4。</string>
    <string name="settings_idle_release">会话闲置释放</string>
    <string name="settings_idle_release_hint">下一次 AI 推理结束后按新策略释放；低端档始终在推理结束后立即释放。</string>
    <string name="settings_inpaint_mode">消除默认档</string>
    <string name="settings_inpaint_mode_hint">精细档细节更好但耗时更长；下次打开消除面板生效。</string>
    <string name="settings_inpaint_brush">消除默认笔刷直径</string>
    <string name="settings_inpaint_brush_hint">单位像素，范围 8–1200；下次打开消除面板生效。</string>
    <string name="settings_live_preset_apply_ai">联机预设套用 AI 参数</string>
    <string name="settings_live_preset_apply_ai_hint">决定入库预处理是否携带主体与天空参数；关闭可缩短同步后的等待。</string>

    <!-- Cloud -->
    <string name="settings_cloud_status">云端总开关</string>
    <string name="settings_cloud_status_hint">只读镜像，切换请进入云端配置；密钥与状态必须同源。</string>
    <string name="settings_cloud_enabled">已开启</string>
    <string name="settings_cloud_disabled">已关闭（默认）</string>
    <string name="settings_cloud_entry">云端配置</string>
    <string name="settings_cloud_entry_hint">配置档 · 连接测试 · ComfyUI 工作流导入。</string>

    <!-- Storage and cache -->
    <string name="settings_storage_models">模型</string>
    <string name="settings_storage_ai_edits">AI 编辑资产</string>
    <string name="settings_storage_preview_cache">预览缓存</string>
    <string name="settings_storage_lut">LUT</string>
    <string name="settings_storage_sky">天空素材</string>
    <string name="settings_storage_unknown">—</string>
    <string name="settings_storage_hint">五类目录实时占用；清理只删除对应文件，不删除已保存的编辑记录。模型与 AI 资产清除后需要重新下载或重新生成。</string>
    <string name="settings_storage_total">合计占用</string>
    <string name="settings_storage_clear">清理</string>
    <string name="settings_storage_clear_all">一键清理</string>
    <string name="settings_storage_cleared">已清理 %1$s</string>
    <string name="settings_storage_clear_models_title">清理全部模型</string>
    <string name="settings_storage_clear_models_message">将删除已下载的 AI 模型文件（MODNet、MI-GAN 及 MediaPipe 人像模型）。已保存的编辑记录本身不会删除，但下次使用相关 AI 工具时需要重新下载或本地导入。是否继续？</string>
    <string name="settings_storage_clear_ai_edits_title">清理 AI 编辑资产</string>
    <string name="settings_storage_clear_ai_edits_message">将删除主体蒙版、天空蒙版、云端图层与消除补丁等外置资产。已保存的编辑记录不会删除，但其中引用这些资产的 AI 效果将无法显示，需要重新生成。此操作不可撤销，是否继续？</string>
    <string name="settings_storage_clear_preview_title">清理预览缓存</string>
    <string name="settings_storage_clear_preview_message">将删除编辑器生成的预览缓存。缩略图会在下次打开时自动重新生成，不影响任何编辑记录或原始照片。是否继续？</string>
    <string name="settings_storage_clear_lut_title">清理 LUT 库</string>
    <string name="settings_storage_clear_lut_message">将删除全部已导入的 3D LUT 文件。已保存的编辑记录不会删除，但引用这些 LUT 的照片将按无 LUT 渲染，需要重新导入。是否继续？</string>
    <string name="settings_storage_clear_sky_title">清理天空素材</string>
    <string name="settings_storage_clear_sky_message">将删除全部已导入的天空照片。已保存的编辑记录不会删除，但引用这些素材的照片将回退到原始天空，需要重新导入。是否继续？</string>
    <string name="settings_storage_clear_all_title">清理全部存储</string>
    <string name="settings_storage_clear_all_message">将删除模型、AI 编辑资产、预览缓存、LUT 库与天空素材的全部文件。已保存的编辑记录本身不会删除，但引用这些资产的 AI 效果将无法显示，模型与素材需要重新下载或导入。此操作不可撤销，是否继续？</string>

