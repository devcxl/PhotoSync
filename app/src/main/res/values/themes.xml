<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PhotoSync" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/darkroom_bg</item>
        <item name="android:colorBackground">@color/darkroom_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:alertDialogTheme">@style/Theme.PhotoSync.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.PhotoSync.Dialog</item>
    </style>

    <style name="Theme.PhotoSync.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_dark</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:textColorPrimary">@color/darkroom_text_primary</item>
        <item name="android:textColorSecondary">@color/darkroom_text_secondary</item>
    </style>
</resources>
