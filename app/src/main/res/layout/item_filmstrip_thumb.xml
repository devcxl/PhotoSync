<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="64dp"
    android:layout_height="42dp"
    android:layout_marginEnd="6dp"
    android:background="@color/darkroom_surface_elevated"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/thumbImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"/>

    <TextView
        android:id="@+id/thumbRawBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="3dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_filmstrip_badge_raw"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:text="@string/format_raw"
        android:textColor="@color/badge_raw_text"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/thumbEditedBadge"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="3dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_filmstrip_badge_edited"
        android:gravity="center"
        android:text="@string/filmstrip_edited_mark"
        android:textColor="@android:color/white"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/thumbExportedBadge"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="3dp"
        android:background="@drawable/bg_filmstrip_badge_exp"
        android:gravity="center"
        android:text="@string/filmstrip_exported_mark"
        android:textColor="@android:color/white"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/thumbSelectionBadge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="3dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/bg_filmstrip_badge_exp"
        android:gravity="center"
        android:text="@string/filmstrip_selected_mark"
        android:textColor="@android:color/white"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible"/>

    <View
        android:id="@+id/thumbBorderOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_filmstrip_item_normal"/>
</FrameLayout>
