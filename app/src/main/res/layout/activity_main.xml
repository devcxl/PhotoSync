<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkroom_bg"
    android:keepScreenOn="true"
    tools:context=".activity.MainActivity">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:saveEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Empty-library darkroom guidance -->
    <LinearLayout
        android:id="@+id/emptyStateContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_empty_icon">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_camera_24"
                app:tint="@color/darkroom_text_secondary"/>
        </FrameLayout>

        <TextView
            android:id="@+id/emptyTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/darkroom_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="未检测到相机"/>

        <TextView
            android:id="@+id/emptyDescText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxWidth="380dp"
            android:textColor="@color/darkroom_text_secondary"
            android:textSize="13sp"
            tools:text="请通过 USB 数据线连接相机，并确认相机处于 PTP / 电脑遥控模式"/>

        <Button
            android:id="@+id/emptyActionButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_primary_cta"
            android:minWidth="140dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="立即连接相机"
            tools:visibility="visible"/>
    </LinearLayout>

    <!-- Top gradient toolbar -->
    <LinearLayout
        android:id="@+id/topOverlayBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Connection status pill -->
        <LinearLayout
            android:id="@+id/connectButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_bar_control_height"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <View
                android:id="@+id/connectStatusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_status_dot"/>

            <TextView
                android:id="@+id/connectButtonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/camera_not_detected"
                android:textColor="@color/darkroom_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Photo metadata pill -->
        <LinearLayout
            android:id="@+id/photoMetaPill"
            android:layout_width="0dp"
            android:layout_height="@dimen/top_bar_control_height"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/photoCounterText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/darkroom_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="1 / 12"/>

                <TextView
                    android:id="@+id/photoNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:textColor="@color/darkroom_text_secondary"
                    android:textSize="12sp"
                    tools:text="DSC04821.ARW"/>

                <TextView
                    android:id="@+id/photoFormatBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_raw"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/badge_raw_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="RAW"/>

                <TextView
                    android:id="@+id/photoEditedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_edited_pill"
                    android:paddingStart="7dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="1dp"
                    android:text="@string/edited_badge"
                    android:textColor="@color/toggle_on_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible"/>

                <TextView
                    android:id="@+id/photoExportedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_exported_pill"
                    android:paddingStart="7dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="1dp"
                    android:text="@string/exported_badge"
                    android:textColor="@color/exported_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible"/>
            </LinearLayout>
        </LinearLayout>

        <Space
            android:id="@+id/topBarSpacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="visible"/>

        <!-- AutoFollow toggle -->
        <LinearLayout
            android:id="@+id/autoFollowToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_bar_control_height"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_toggle_pill_on"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="11dp">

            <ImageView
                android:id="@+id/autoFollowIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_follow_24"
                app:tint="@color/toggle_on_text"/>

            <TextView
                android:id="@+id/autoFollowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_follow_toggle"
                android:textColor="@color/toggle_on_text"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Info drawer toggle -->
        <LinearLayout
            android:id="@+id/infoToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_bar_control_height"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_toggle_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_info_24"
                app:tint="@color/darkroom_text_secondary"/>

            <TextView
                android:id="@+id/infoToggleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/photo_info_toggle"
                android:textColor="@color/darkroom_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Action buttons (circle diameter unified with top bar height) -->
        <ImageButton
            android:id="@+id/editButton"
            android:layout_width="@dimen/top_bar_control_height"
            android:layout_height="@dimen/top_bar_control_height"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_glass_icon_btn"
            android:contentDescription="@string/edit_photo"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_edit_24"
            app:tint="@color/darkroom_text_primary"/>

        <FrameLayout
            android:layout_width="@dimen/top_bar_control_height"
            android:layout_height="@dimen/top_bar_control_height"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/exportButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_icon_btn"
                android:contentDescription="@string/export_to_gallery"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_export_24"
                app:tint="@color/darkroom_text_primary"/>

            <ProgressBar
                android:id="@+id/exportButtonSpinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_blue"
                android:visibility="gone"/>
        </FrameLayout>

        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="@dimen/top_bar_control_height"
            android:layout_height="@dimen/top_bar_control_height"
            android:background="@drawable/bg_glass_icon_btn_danger"
            android:contentDescription="@string/delete_photo"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete_24"
            app:tint="@color/darkroom_text_primary"/>
    </LinearLayout>

    <!-- Press-and-hold compare pill: mirrors the editor's "未编辑原图 (Before)" -->
    <TextView
        android:id="@+id/compareStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:background="@drawable/bg_compare_pill"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="@string/compare_original_pill"
        android:textColor="@color/darkroom_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible"/>

    <!-- Collapsible photo technical info drawer -->
    <LinearLayout
        android:id="@+id/infoDrawerPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_info_card"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_marginEnd="96dp"
        tools:layout_marginTop="52dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_label_resolution"
                android:textColor="@color/darkroom_text_muted"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/infoResolutionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/darkroom_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="6000 × 4000"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_label_format_size"
                android:textColor="@color/darkroom_text_muted"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/infoFormatSizeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/darkroom_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="RAW · 48.6 MB"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_label_camera_handle"
                android:textColor="@color/darkroom_text_muted"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/infoHandleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/darkroom_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="#0x10042"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Top-right compact Sync transfer progress card -->
    <LinearLayout
        android:id="@+id/transferStatusCard"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topOverlayBar"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/transferLabelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/sync_transfer_in_progress"
                android:textColor="@color/darkroom_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/transferPercentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="64%"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#26FFFFFF"
            android:progressTint="@color/accent_blue"/>
    </LinearLayout>

    <!-- Single-line replaceable inline feedback pill -->
    <TextView
        android:id="@+id/inlineFeedbackPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0"
        android:background="@drawable/bg_glass_pill"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="360dp"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@color/darkroom_text_primary"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topOverlayBar"
        tools:alpha="1"
        tools:text="已导出到相册: DSC04821_export.jpg"
        tools:visibility="visible"/>

    <!-- Bottom-left real-time zoom multiplier badge -->
    <TextView
        android:id="@+id/zoomBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_zoom_badge"
        android:fontFamily="monospace"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/darkroom_text_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="2.1x"
        tools:visibility="visible"/>

    <!-- Non-intrusive incoming photo pill -->
    <TextView
        android:id="@+id/newPhotoBanner"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="@dimen/banner_margin_default"
        android:background="@drawable/bg_new_photo_banner"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#EFF6FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomFilmstripContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="12dp"
        tools:text="收到 1 张新照片 · 点击跳转"
        tools:visibility="visible"/>

    <!-- Collapsible bottom thumbnail filmstrip -->
    <LinearLayout
        android:id="@+id/bottomFilmstripContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_scrim"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <!-- Quick preset + tethered actions strip, collapsed by default -->
        <LinearLayout
            android:id="@+id/quickPresetStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_quick_strip"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/quickStripToggleHandle"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_filmstrip_handle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/quick_strip_expand"
                    android:textColor="@color/darkroom_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/quickLiveTetherToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_toggle_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/quick_strip_live_tether"
                    android:textColor="@color/darkroom_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <ImageButton
                    android:id="@+id/quickCompareButton"
                    android:layout_width="32dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_toggle_pill"
                    android:contentDescription="@string/quick_strip_compare_hold"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_compare_24"
                    android:visibility="gone"
                    app:tint="@color/darkroom_text_primary"
                    tools:visibility="visible"/>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/filmstripToggleHandle"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_filmstrip_handle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/filmstrip_collapse"
                    android:textColor="@color/darkroom_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/quickPresetChipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/quickPresetChipContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filmstripRecyclerView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filmstrip_tray"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="0dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>

    <!-- Dedicated export / bake progress overlay -->
    <FrameLayout
        android:id="@+id/exportProgressOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#8C000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_horizontal"
            android:minWidth="230dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_blue"/>

            <TextView
                android:id="@+id/exportProgressTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/export_progress_baking_title"
                android:textColor="@color/darkroom_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/exportProgressSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:gravity="center"
                android:maxLines="2"
                android:maxWidth="240dp"
                android:text="@string/export_progress_baking_detail"
                android:textColor="@color/darkroom_text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
