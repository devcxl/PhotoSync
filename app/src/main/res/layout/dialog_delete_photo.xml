<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/deleteMessageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/dialog_delete_message"
        android:textColor="@color/darkroom_text_secondary"
        android:textSize="13sp"/>

    <LinearLayout
        android:id="@+id/cameraDeleteBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_camera_delete_box"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <CheckBox
            android:id="@+id/deleteOnCameraCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/danger_text"
            android:checked="false"
            android:enabled="false"
            android:text="@string/delete_on_camera"
            android:textColor="@color/danger_text"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/cameraDeleteHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="4dp"
            android:textColor="@color/darkroom_text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="相机未连接，只能删除本机副本"
            tools:visibility="visible"/>
    </LinearLayout>

</LinearLayout>
