<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_info_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/modelNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/darkroom_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="MODNet 人像抠图"/>

        <TextView
            android:id="@+id/modelStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/darkroom_text_secondary"
            android:textSize="12sp"
            tools:text="未下载"/>
    </LinearLayout>

    <TextView
        android:id="@+id/modelDescriptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/darkroom_text_secondary"
        android:textSize="12sp"
        tools:text="512×512 FP32 · 生成人像主体蒙版"/>

    <TextView
        android:id="@+id/modelMetaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/darkroom_text_muted"
        android:textSize="12sp"
        tools:text="体积：25.9 MB · 版本：1"/>

    <TextView
        android:id="@+id/modelLicenseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/darkroom_text_muted"
        android:textSize="12sp"
        tools:text="许可证：Apache-2.0"/>

    <ProgressBar
        android:id="@+id/modelProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="100"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="@color/accent_blue"
        android:visibility="gone"
        tools:visibility="visible"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/modelImportButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_glass_pill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/ai_models_import"
            android:textAllCaps="false"
            android:textColor="@color/darkroom_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible"/>

        <Button
            android:id="@+id/modelDownloadButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_primary_cta"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/ai_models_download"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:visibility="visible"/>

        <Button
            android:id="@+id/modelDeleteButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_pill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/ai_models_delete"
            android:textAllCaps="false"
            android:textColor="@color/darkroom_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible"/>
    </LinearLayout>
</LinearLayout>
