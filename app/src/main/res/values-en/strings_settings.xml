    <!-- Tethering and gallery -->
    <string name="settings_auto_follow">Auto-advance to new photos</string>
    <string name="settings_auto_follow_hint">Jumps to the newest frame after ingest; it never interrupts a zoomed-in view.</string>
    <string name="settings_delete_on_camera">Also delete the camera original</string>
    <string name="settings_delete_on_camera_hint">Kept in sync with the delete dialog checkbox; falls back to local-only when the camera cannot delete.</string>
    <string name="settings_keep_screen_on">Keep the screen on while browsing</string>
    <string name="settings_keep_screen_on_hint">Only affects screen-on policy in the gallery and editor, never the exported pixels.</string>
    <string name="settings_live_preset_enabled">Apply live tether presets automatically</string>
    <string name="settings_live_preset_enabled_hint">When off, the selected preset is remembered but no longer applied to new photos.</string>

    <!-- Editor -->
    <string name="settings_preview_resolution">Preview resolution</string>
    <string name="settings_preview_resolution_hint">Applies the next time the editor opens; the sky preview follows at the same ratio.</string>
    <string name="settings_export_quality">Export JPEG quality</string>
    <string name="settings_export_quality_hint">Applies to the next export; range 85–100.</string>
    <string name="settings_undo_depth">Undo depth</string>
    <string name="settings_undo_depth_hint">Applies the next time the editor opens; range 20–200 steps.</string>
    <string name="settings_lut_library">LUT library</string>
    <string name="settings_lut_library_hint">Tap to inspect imported entries, usage and deletion; imports a .cube file through SAF.</string>

    <!-- AI tools -->
    <string name="settings_ai_models">AI model management</string>
    <string name="settings_ai_models_hint">On-demand download, local import and verification status.</string>
    <string name="settings_sky_assets">Sky assets</string>
    <string name="settings_sky_assets_hint">Tap to inspect imported skies, usage and deletion; imports an image through SAF.</string>
    <string name="settings_tier_override">Device tier override</string>
    <string name="settings_tier_override_hint">Only affects AI runtime policy and memory budget, never pixel output; applies to the next AI inference.</string>
    <string name="settings_intra_threads">Inference threads</string>
    <string name="settings_intra_threads_hint">Applies the next time a model loads; range 1–4.</string>
    <string name="settings_idle_release">Idle session release</string>
    <string name="settings_idle_release_hint">Applied after the next AI inference; low-tier devices always release right after inference.</string>
    <string name="settings_inpaint_mode">Default inpaint quality</string>
    <string name="settings_inpaint_mode_hint">Fine keeps more detail but takes longer; applies when the inpaint panel next opens.</string>
    <string name="settings_inpaint_brush">Default inpaint brush diameter</string>
    <string name="settings_inpaint_brush_hint">In pixels, range 8–1200; applies when the inpaint panel next opens.</string>
    <string name="settings_live_preset_apply_ai">Apply AI parameters in live presets</string>
    <string name="settings_live_preset_apply_ai_hint">Controls whether ingest prep carries subject and sky parameters; off shortens the wait after a shot.</string>

    <!-- Cloud -->
    <string name="settings_cloud_status">Cloud master switch</string>
    <string name="settings_cloud_status_hint">Read-only mirror; toggle it in the cloud page so keys and state stay in sync.</string>
    <string name="settings_cloud_enabled">Enabled</string>
    <string name="settings_cloud_disabled">Disabled (default)</string>
    <string name="settings_cloud_entry">Cloud configuration</string>
    <string name="settings_cloud_entry_hint">Profiles · connection test · ComfyUI workflow import.</string>

    <!-- Storage and cache -->
    <string name="settings_storage_models">Models</string>
    <string name="settings_storage_ai_edits">AI edit assets</string>
    <string name="settings_storage_preview_cache">Preview cache</string>
    <string name="settings_storage_lut">LUTs</string>
    <string name="settings_storage_sky">Sky assets</string>
    <string name="settings_storage_unknown">—</string>
    <string name="settings_storage_hint">Live usage of the five folders. Cleanup only removes files, never saved edit records; models and AI assets must be downloaded or regenerated again.</string>
    <string name="settings_storage_total">Total usage</string>
    <string name="settings_storage_clear">Clear</string>
    <string name="settings_storage_clear_all">Clear all</string>
    <string name="settings_storage_cleared">Freed %1$s</string>
    <string name="settings_storage_clear_models_title">Clear all models</string>
    <string name="settings_storage_clear_models_message">This removes the downloaded AI model files (MODNet, MI-GAN and the MediaPipe portrait model). Saved edit records are kept, but the next use of the matching AI tool needs a new download or local import. Continue?</string>
    <string name="settings_storage_clear_ai_edits_title">Clear AI edit assets</string>
    <string name="settings_storage_clear_ai_edits_message">This removes subject masks, sky masks, cloud layers and inpaint patches. Saved edit records are kept, but AI effects that reference these assets will not render until regenerated. This cannot be undone. Continue?</string>
    <string name="settings_storage_clear_preview_title">Clear preview cache</string>
    <string name="settings_storage_clear_preview_message">This removes the editor-generated preview cache. Thumbnails regenerate on the next open; no edit record or original photo is touched. Continue?</string>
    <string name="settings_storage_clear_lut_title">Clear LUT library</string>
    <string name="settings_storage_clear_lut_message">This removes every imported 3D LUT. Saved edit records are kept, but photos referencing them render without the LUT until re-imported. Continue?</string>
    <string name="settings_storage_clear_sky_title">Clear sky assets</string>
    <string name="settings_storage_clear_sky_message">This removes every imported sky photo. Saved edit records are kept, but photos referencing them fall back to the original sky until re-imported. Continue?</string>
    <string name="settings_storage_clear_all_title">Clear all storage</string>
    <string name="settings_storage_clear_all_message">This removes every file in models, AI edit assets, preview cache, LUT library and sky assets. Saved edit records are kept, but AI effects referencing these assets will not render and models/assets must be downloaded or imported again. This cannot be undone. Continue?</string>

