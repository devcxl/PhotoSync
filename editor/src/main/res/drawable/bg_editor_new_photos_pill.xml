<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet "+N 新照片" pill: translucent blue so it reads as a notification, not a control. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/editor_accent_blue_pill" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="@color/editor_accent_blue_border" />

</shape>
