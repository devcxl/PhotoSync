<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/baseLookLabel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:text="@string/editor_base_look_label"
        android:textColor="@color/editor_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/baseLookCameraDefault"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/editor_base_look_camera_default"
        android:textColor="@color/editor_text_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="默认观感" />

    <TextView
        android:id="@+id/baseLookSeparator"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/editor_base_look_separator"
        android:textColor="@color/editor_text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/baseLookLinearNeutral"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="10dp"
        android:text="@string/editor_base_look_linear_neutral"
        android:textColor="@color/editor_text_muted"
        android:textSize="11sp"
        tools:text="线性中性" />
</merge>
