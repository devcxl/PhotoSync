<?xml version="1.0" encoding="utf-8"?>
<!-- Tier-1 controls of the AI > 云端 tool. Inflated into CloudPanelView. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/editor_cloud_panel_title"
        android:textColor="@color/editor_text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/cloudModeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <EditText
        android:id="@+id/cloudPromptInput"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@color/editor_surface_elevated"
        android:hint="@string/editor_cloud_prompt_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/editor_text_primary"
        android:textColorHint="@color/editor_text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cloudSoftMaskWarning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            android:text="@string/editor_cloud_soft_mask_warning"
            android:textColor="@color/editor_zero_pin"
            android:textSize="10sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/cloudProviderHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            android:text="@string/editor_cloud_provider_hint"
            android:textColor="@color/editor_text_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/cloudGenerateButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@color/editor_accent_blue"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/editor_cloud_generate"
            android:textColor="@color/editor_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cloudLayerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editor_cloud_opacity_label"
                android:textColor="@color/editor_text_secondary"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/cloudOpacitySeek"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="100" />

            <TextView
                android:id="@+id/cloudOpacityValue"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/editor_text_primary"
                android:textSize="11sp"
                tools:text="100%" />
        </LinearLayout>

        <TextView
            android:id="@+id/cloudRemoveLayerButton"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="2dp"
            android:background="@color/editor_surface_elevated"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/editor_cloud_remove_layer"
            android:textColor="@color/editor_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</merge>
