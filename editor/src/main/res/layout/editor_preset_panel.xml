<?xml version="1.0" encoding="utf-8"?>
<!-- Tier-1 control slot of the 预设 group: save the current look, apply a preset, clear it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/presetPanelRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/presetSaveCurrentChip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@color/editor_surface_elevated"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="@string/editor_preset_save_current"
            android:textColor="@color/editor_text_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/presetEmptyHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/editor_preset_empty"
            android:textColor="@color/editor_text_muted"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/presetChipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/presetChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

</LinearLayout>
