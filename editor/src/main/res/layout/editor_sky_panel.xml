<?xml version="1.0" encoding="utf-8"?>
<cn.devcxl.photosync.editor.ui.widgets.SkyPanelView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/editor_sky_panel_title"
        android:textColor="@color/editor_text_secondary"
        android:textSize="11sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/skyChipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/skyDialContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/skyNoSkyHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_editor_new_photos_pill"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="@string/editor_sky_no_sky_hint"
        android:textColor="@color/editor_text_primary"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/skyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/editor_sky_hint"
        android:textColor="@color/editor_text_muted"
        android:textSize="11sp" />
</cn.devcxl.photosync.editor.ui.widgets.SkyPanelView>
